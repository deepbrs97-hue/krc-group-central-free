{
  "name": "krc-brs",
  "version": "4.0.0",
  "private": true,
  "description": "KRC GROUP professional Windows desktop app with polished module management, embedded web modules and full module CRUD",
  "main": "electron-main.js",
  "author": "KRC GROUP",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "http-proxy-middleware": "^3.0.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.krcbrs.admin",
    "productName": "KRC GROUP",
    "artifactName": "KRC-GROUP-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "**/*",
      "!data.sqlite",
      "!data.sqlite-journal"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/assets/krc-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KRC GROUP"
    }
  }
}
