# PostgreSQL connection string from Neon/Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Welcome
SESSION_SECRET=replace-with-a-long-random-secret
TZ=Asia/Kolkata
# Leave empty on the central cloud server. Set this to the deployed Render URL on desktop clients.
KRC_CLOUD_API_URL=
